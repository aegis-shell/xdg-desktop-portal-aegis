#!/bin/sh
set -eu

added_lines=$(git diff --cached --unified=0 -- Cargo.toml Cargo.lock .cargo ':glob:**/Cargo.toml' |
    sed -n 's/^+//p')

if printf '%s\n' "$added_lines" |
    grep -Eq 'aegis-shell/aegis|path[[:space:]]*=[[:space:]]*"\.\./aegis'; then
    printf '%s\n' \
        "Portal builds must not depend on the Aegis source repository." \
        "Use the Portal-owned aegis-portal-ipc wire projection instead."
    exit 1
fi
